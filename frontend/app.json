{
  "expo": {
    "name": "BIBLIA",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.gotteswortapp.nia5as",
      "infoPlist": {
        "NSCameraUsageDescription": "Fotos zu Bibelstellen und Lektionen aufnehmen",
        "NSPhotoLibraryUsageDescription": "Fotos zu Bibelstellen und Lektionen speichern"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F3E8"
      },
      "package": "com.emergent.gotteswortapp.nia5as",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/feather",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotos zu Bibelstellen und Lektionen speichern",
          "cameraPermission": "Fotos zu Bibelstellen und Lektionen aufnehmen",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}